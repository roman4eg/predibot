# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Polling interval in seconds (default: 30)
POLLING_INTERVAL=30

# Predict.fun API URL (optional, default: https://api.predict.fun)
# PREDICT_API_URL=https://api.predict.fun

# Predict.fun API Key (optional, for higher rate limits)
# Get from https://dev.predict.fun/
# PREDICT_API_KEY=your_api_key_here
